// -*- mode: c++ -*-

#define __RAPTOR_MPFR_BINOP_DF(LLVM_OP_NAME, MPFR_FUNC_NAME, RND_MODE)         \
  __RAPTOR_MPFR_BIN(binop, LLVM_OP_NAME, MPFR_FUNC_NAME, ieee_64, double, d,   \
                    double, d, double, d, RND_MODE)                            \
  __RAPTOR_MPFR_BIN(binop, LLVM_OP_NAME, MPFR_FUNC_NAME, ieee_32, float, d,    \
                    float, d, float, d, RND_MODE)

#define __RAPTOR_MPFR_BINFUNCINTR_DF(LLVM_OP_NAME, MPFR_FUNC_NAME, RND_MODE)   \
  __RAPTOR_MPFR_BIN(intr, LLVM_OP_NAME, MPFR_FUNC_NAME, ieee_64, double, d,    \
                    double, d, double, d, RND_MODE)                            \
  __RAPTOR_MPFR_BIN(intr, llvm_##LLVM_OP_NAME##_f64, MPFR_FUNC_NAME, ieee_64,  \
                    double, d, double, d, double, d, RND_MODE)                 \
  __RAPTOR_MPFR_BIN(func, LLVM_OP_NAME, MPFR_FUNC_NAME, ieee_64, double, d,    \
                    double, d, double, d, RND_MODE)                            \
  __RAPTOR_MPFR_BIN(func, __##LLVM_OP_NAME##_finite, MPFR_FUNC_NAME, ieee_64,  \
                    double, d, double, d, double, d, RND_MODE)                 \
  __RAPTOR_MPFR_BIN(intr, LLVM_OP_NAME, MPFR_FUNC_NAME, ieee_32, float, d,     \
                    float, d, float, d, RND_MODE)                              \
  __RAPTOR_MPFR_BIN(intr, llvm_##LLVM_OP_NAME##_f32, MPFR_FUNC_NAME, ieee_32,  \
                    float, d, float, d, float, d, RND_MODE)                    \
  __RAPTOR_MPFR_BIN(func, LLVM_OP_NAME, MPFR_FUNC_NAME, ieee_32, float, d,     \
                    float, d, float, d, RND_MODE)                              \
  __RAPTOR_MPFR_BIN(func, __##LLVM_OP_NAME##_finite, MPFR_FUNC_NAME, ieee_32,  \
                    float, d, float, d, float, d, RND_MODE)

#define __RAPTOR_MPFR_BINOP_DF_DFLTRND(LLVM_OP_NAME, MPFR_FUNC_NAME)           \
  __RAPTOR_MPFR_BINOP_DF(LLVM_OP_NAME, MPFR_FUNC_NAME,                         \
                         __RAPTOR_MPFR_DEFAULT_ROUND_MODE)

#define __RAPTOR_MPFR_BINFUNCINTR_DF_DFLTRND(LLVM_OP_NAME, MPFR_FUNC_NAME)     \
  __RAPTOR_MPFR_BINFUNCINTR_DF(LLVM_OP_NAME, MPFR_FUNC_NAME,                   \
                               __RAPTOR_MPFR_DEFAULT_ROUND_MODE)

#define __RAPTOR_MPFR_SINGFUNCINTR_DF(LLVM_NAME, MPFR_NAME, RND_MODE)          \
  __RAPTOR_MPFR_SING(intr, LLVM_NAME, MPFR_NAME, ieee_64, double, d, double,   \
                     d, RND_MODE)                                              \
  __RAPTOR_MPFR_SING(intr, llvm_##LLVM_NAME##_f64, MPFR_NAME, ieee_64, double, \
                     d, double, d, RND_MODE)                                   \
  __RAPTOR_MPFR_SING(func, LLVM_NAME, MPFR_NAME, ieee_64, double, d, double,   \
                     d, RND_MODE)                                              \
  __RAPTOR_MPFR_SING(func, __##LLVM_NAME##_finite, MPFR_NAME, ieee_64, double, \
                     d, double, d, RND_MODE)                                   \
  __RAPTOR_MPFR_SING(intr, LLVM_NAME, MPFR_NAME, ieee_32, float, d, float,     \
                     d, RND_MODE)                                              \
  __RAPTOR_MPFR_SING(intr, llvm_##LLVM_NAME##_f32, MPFR_NAME, ieee_32, float,  \
                     d, float, d, RND_MODE)                                    \
  __RAPTOR_MPFR_SING(func, LLVM_NAME, MPFR_NAME, ieee_32, float, d, float, d,  \
                     RND_MODE)                                                 \
  __RAPTOR_MPFR_SING(func, __##LLVM_NAME##_finite, MPFR_NAME, ieee_32, float,  \
                     d, float, d, RND_MODE)

#define __RAPTOR_MPFR_SINGFUNCINTR_DF_NORND(LLVM_NAME, MPFR_NAME)              \
  __RAPTOR_MPFR_SING_NORND(intr, LLVM_NAME, MPFR_NAME, ieee_64, double, d,     \
                           double, d, __RAPTOR_MPFR_DEFAULT_ROUND_MODE)        \
  __RAPTOR_MPFR_SING_NORND(intr, llvm_##LLVM_NAME##_f64, MPFR_NAME, ieee_64,   \
                           double, d, double, d,                               \
                           __RAPTOR_MPFR_DEFAULT_ROUND_MODE)                   \
  __RAPTOR_MPFR_SING_NORND(func, LLVM_NAME, MPFR_NAME, ieee_64, double, d,     \
                           double, d, __RAPTOR_MPFR_DEFAULT_ROUND_MODE)        \
  __RAPTOR_MPFR_SING_NORND(func, __##LLVM_NAME##_finite, MPFR_NAME, ieee_64,   \
                           double, d, double, d,                               \
                           __RAPTOR_MPFR_DEFAULT_ROUND_MODE)                   \
  __RAPTOR_MPFR_SING_NORND(intr, LLVM_NAME, MPFR_NAME, ieee_32, float, d,      \
                           float, d, __RAPTOR_MPFR_DEFAULT_ROUND_MODE)         \
  __RAPTOR_MPFR_SING_NORND(intr, llvm_##LLVM_NAME##_f32, MPFR_NAME, ieee_32,   \
                           float, d, float, d,                                 \
                           __RAPTOR_MPFR_DEFAULT_ROUND_MODE)                   \
  __RAPTOR_MPFR_SING_NORND(func, LLVM_NAME, MPFR_NAME, ieee_32, float, d,      \
                           float, d, __RAPTOR_MPFR_DEFAULT_ROUND_MODE)         \
  __RAPTOR_MPFR_SING_NORND(func, __##LLVM_NAME##_finite, MPFR_NAME, ieee_32,   \
                           float, d, float, d,                                 \
                           __RAPTOR_MPFR_DEFAULT_ROUND_MODE)

#define __RAPTOR_MPFR_SINGFUNCINTR_DF_DFLTRND(LLVM_OP_NAME, MPFR_FUNC_NAME)    \
  __RAPTOR_MPFR_SINGFUNCINTR_DF(LLVM_OP_NAME, MPFR_FUNC_NAME,                  \
                                __RAPTOR_MPFR_DEFAULT_ROUND_MODE)

#define __RAPTOR_MPFR_FCMP_DF(NAME, ORDERED, CMP, RND_MODE)                   \
  __RAPTOR_MPFR_FCMP(NAME, ORDERED, CMP, ieee_64, double, d, RND_MODE)        \
  __RAPTOR_MPFR_FCMP(NAME, ORDERED, CMP, ieee_32, float, d, RND_MODE)

#define __RAPTOR_MPFR_FCMP_DF_DFLTRND(NAME, ORDERED, CMP)                     \
  __RAPTOR_MPFR_FCMP_DF(NAME, ORDERED, CMP, __RAPTOR_MPFR_DEFAULT_ROUND_MODE)



